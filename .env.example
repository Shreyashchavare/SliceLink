# ==============================================================================
# SliceLink Environment Configuration Template (.env.example)
# Copy this file to .env for local Docker Compose execution.
# NEVER commit the real .env file containing production secrets.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_DB=slicelink
POSTGRES_USER=slicelink
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Cache Configuration (Redis)
REDIS_PORT=6379

# Event Streaming (Apache Kafka KRaft)
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Port Exposure (Docker Host)
BACKEND_PORT=8080
FRONTEND_PORT=80

# Security & JWT Authentication (Min 32 characters high-entropy string)
SLICELINK_JWT_SECRET=replace-with-a-unique-local-development-secret-at-least-32-characters
SLICELINK_JWT_ACCESS_TOKEN_TTL=PT15M
SLICELINK_JWT_REFRESH_TOKEN_TTL=P7D

# CORS Configuration (Allowed web origin)
SLICELINK_CORS_ALLOWED_ORIGIN=http://localhost

# Cache TTL & Rate Limiting
SLICELINK_CACHE_URL_TTL=PT24H
SLICELINK_RATE_LIMIT_LOGIN_MAX_REQUESTS=5
SLICELINK_RATE_LIMIT_LOGIN_WINDOW=PT1M
SLICELINK_RATE_LIMIT_URL_CREATE_MAX_REQUESTS=20
SLICELINK_RATE_LIMIT_URL_CREATE_WINDOW=PT1M
